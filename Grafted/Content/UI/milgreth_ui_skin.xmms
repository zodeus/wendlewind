<?xml version="1.0" encoding="utf-8"?>
<Stylesheet TextureRegionAtlas="milgreth_ui_skin.xmat">
    <Fonts UsedSpace="0, 0, 4096, 2000">
        <Font Id="small-font" File="../Fonts/JetBrainsMono-Regular.ttf" Size="14"/>
        <Font Id="default-font" File="../Fonts/JetBrainsMono-Regular.ttf" Size="16"/>
        <Font Id="medium-font" File="../Fonts/JetBrainsMono-Regular.ttf" Size="20"/>
        <Font Id="large-font" File="../Fonts/JetBrainsMono-Regular.ttf" Size="24"/>
    </Fonts>
    <LabelStyles>
        <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        <LabelStyle Id="small" Font="small-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        <LabelStyle Id="medium" Font="medium-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        <LabelStyle Id="success" Font="default-font" TextColor="#459D00" DisabledTextColor="gray"/>
        <LabelStyle Id="ongoing" Font="default-font" TextColor="#38383e" DisabledTextColor="gray"/>
        <LabelStyle Id="error" Font="default-font" TextColor="#c80000" DisabledTextColor="gray"/>
        <LabelStyle Id="error--dark" Font="default-font" TextColor="#780000" DisabledTextColor="gray"/>
        <LabelStyle Id="large" Font="large-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        <LabelStyle Id="ai-visualizer__final-decision--hit" Font="small-font" TextColor="#a88d28" DisabledTextColor="gray"/>
        <LabelStyle Id="ai-visualizer__final-decision--miss" Font="small-font" TextColor="#780000" DisabledTextColor="gray"/>
    </LabelStyles>
    <!--<PanelStyles>
        <PanelStyle Id="panel-medium" Background="panel-frame-medium" Padding="15"/>
    </PanelStyles>-->
    <TextBoxStyles>
        <TextBoxStyle Background="textfield" TextColor="#b3b3b3" DisabledTextColor="gray" Font="default-font" Cursor="input-cursor" Selection="selection" Padding="10, 6, 10, 6"/>
    </TextBoxStyles>
    <ScrollViewerStyles>
        <ScrollViewerStyle HorizontalScrollBackground="scroll-frame" HorizontalScrollKnob="scroll-handle-horizontal" VerticalScrollBackground="scroll-frame" VerticalScrollKnob="scroll-handle-vertical"/>
    </ScrollViewerStyles>
    <ButtonStyles>
        <ButtonStyle>
            <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>1
        </ButtonStyle>
        <ButtonStyle Id="normal" Padding="11,10,11,10" Background="button-normal-default" OverBackground="button-normal-over" PressedBackground="button-normal-pressed">
            <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        </ButtonStyle>
        <ButtonStyle Id="small" Padding="6" Background="button-small-default" OverBackground="button-small-over" PressedBackground="button-small-pressed">
            <LabelStyle Font="small-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        </ButtonStyle>
        <ButtonStyle Id="large" Padding="14" Background="button-large-default" OverBackground="button-large-over" PressedBackground="button-large-pressed">
            <LabelStyle Font="large-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        </ButtonStyle>
        <ButtonStyle Id="icon" Padding="3" Background="button-small-default" OverBackground="button-small-over" PressedBackground="button-small-pressed"/>
        <ButtonStyle Id="plus-24" Width="24" Height="24" Background="icon-plus-24-default" OverBackground="icon-plus-24-over" PressedBackground="icon-plus-24-pressed"/>
        <ButtonStyle Id="minus-24" Width="24" Height="24" Background="icon-minus-24-default" OverBackground="icon-minus-24-over" PressedBackground="icon-minus-24-pressed"/>
        <ButtonStyle Id="money-24" Width="24" Height="24" Background="icon-money-24-default" OverBackground="icon-money-24-over" PressedBackground="icon-money-24-pressed"/>
    </ButtonStyles>
    <CheckBoxStyles>
        <CheckBoxStyle>
            <LabelStyle Font="default-font" TextColor="#b3b3b3"/>
            <ImageStyle Background="checkbox-default" OverBackground="checkbox-over" PressedImage="checkbox-selected" Width="24" Height="24"/>
        </CheckBoxStyle>
    </CheckBoxStyles>
    <RadioButtonStyles>
        <RadioButtonStyle>
            <LabelStyle Font="default-font" TextColor="#b3b3b3"/>
            <!--<ImageStyle Image="vis-radio-tick-disabled" PressedImage="vis-radio-tick"/>-->
            <ImageStyle Image="bad-texture" PressedImage="bad-texture"/>
        </RadioButtonStyle>
    </RadioButtonStyles>
    <SpinButtonStyles>
        <SpinButtonStyle Background="textfield">
            <TextBoxStyle TextColor="#b3b3b3" DisabledTextColor="gray" Font="default-font" Cursor="input-cursor" Selection="selection"/>
            <UpButtonStyle Width="12" Height="12" Background="bad-texture" OverBackground="bad-texture" PressedBackground="bad-texture">
            <!--<UpButtonStyle Width="12" Height="12" Background="button" OverBackground="button-over" PressedBackground="button-down">-->
                <!--<ImageStyle Image="select-up"/>-->
                <ImageStyle Image="bad-texture"/>
            </UpButtonStyle>
            <DownButtonStyle Width="12" Height="12" Background="bad-texture" OverBackground="bad-texture" PressedBackground="bad-texture">
            <!--<DownButtonStyle Width="12" Height="12" Background="button" OverBackground="button-over" PressedBackground="button-down">-->
                <!--<ImageStyle Image="select-down"/>-->
                <ImageStyle Image="bad-texture"/>
            </DownButtonStyle>
        </SpinButtonStyle>
    </SpinButtonStyles>
    <HorizontalSliderStyles>
        <!--<HorizontalSliderStyle Background="slider">-->
        <HorizontalSliderStyle Background="bad-texture">
            <KnobStyle>
                <!--<ImageStyle Image="slider-knob" OverImage="slider-knob-over" PressedImage="slider-knob-down"/>-->
                <ImageStyle Image="bad-texture" OverImage="bad-texture" PressedImage="bad-texture"/>
            </KnobStyle>
        </HorizontalSliderStyle>
    </HorizontalSliderStyles>
    <VerticalSliderStyles>
        <!--<VerticalSliderStyle Background="slider-vertical">-->
        <VerticalSliderStyle Background="bad-texture">
            <KnobStyle>
                <!--<ImageStyle Image="slider-knob" OverImage="slider-knob-over" PressedImage="slider-knob-down"/>-->
                <ImageStyle Image="bad-texture" OverImage="bad-texture" PressedImage="bad-texture"/>
            </KnobStyle>
        </VerticalSliderStyle>
    </VerticalSliderStyles>
    <HorizontalProgressBarStyles>
        <HorizontalProgressBarStyle Background="bad-texture" Filler="bad-texture" Height="16"/>
        <!--<HorizontalProgressBarStyle Background="progressbar" Filler="progressbar-filled" Height="16"/>-->
        <HorizontalProgressBarStyle Id="health" Background="bar-frame-small" Filler="bar-health" Padding="2"/>
        <HorizontalProgressBarStyle Id="xp" Background="bar-frame-small" Filler="bar-xp" Padding="4"/>
    </HorizontalProgressBarStyles>
    <VerticalProgressBarStyles>
        <!--<VerticalProgressBarStyle Background="progressbar-vertical" Filler="progressbar-filled-vertical" Width="16"/>-->
        <VerticalProgressBarStyle Background="bad-texture" Filler="bad-texture" Width="16"/>
    </VerticalProgressBarStyles>
    <HorizontalSeparatorStyles>
        <HorizontalSeparatorStyle Image="separator-menu" Color="red" Thickness="5"/>
    </HorizontalSeparatorStyles>
    <VerticalSeparatorStyles>
        <!--<VerticalSeparatorStyle Image="separator" Thickness="2"/>-->
        <VerticalSeparatorStyle Image="separator-vertical" Thickness="5"/>
    </VerticalSeparatorStyles>
    <ComboBoxStyles>
        <!--<ComboBoxStyle Background="default-select">-->
        <ComboBoxStyle Background="textfield" Padding="10, 6, 10, 6">
            <LabelStyle Font="default-font" TextColor="#b3b3b3"/>
            <ListBoxStyle Background="panel-icon-frame" Padding="6" Spacing="20">
                <ListItemStyle OverBackground="button-small-over" PressedBackground="button-small-pressed" Background="panel-icon-frame" Padding="6" Margin="0,0,0,5">
                    <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
                </ListItemStyle>
                <!--<SeparatorStyle Padding="0, 2" Image="input-cursor" Thickness="4"/>-->
            </ListBoxStyle>
        </ComboBoxStyle>
    </ComboBoxStyles>
    <ListBoxStyles>
        <ListBoxStyle Background="button">
            <!--<ListItemStyle OverBackground="button-over" Padding="5, 0" PressedBackground="list-selection">-->
            <ListItemStyle OverBackground="bad-texture" Padding="5, 0" PressedBackground="bad-texture">
                <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
            </ListItemStyle>
            <SeparatorStyle Padding="0, 2" Image="bad-texture" Thickness="4"/>
            <!--<SeparatorStyle Padding="0, 2" Image="separator-menu" Thickness="4"/>-->
        </ListBoxStyle>
    </ListBoxStyles>
    <TabControlStyles>
        <TabControlStyle ButtonSpacing="0">
            <!--<TabItemStyle OverBackground="button-over" Padding="5, 0" PressedBackground="list-selection">-->
            <TabItemStyle OverBackground="bad-texture" Padding="5, 0" PressedBackground="bad-texture">
                <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
            </TabItemStyle>
            <ContentStyle Background="bad-texture" Padding="5"/>
            <!--<ContentStyle Background="window" Padding="5"/>-->
        </TabControlStyle>
    </TabControlStyles>
    <TreeStyles>
        <!--<TreeStyle SelectionBackground="tree-selection" SelectionHoverBackground="button-over">-->
        <TreeStyle SelectionBackground="bad-texture" SelectionHoverBackground="bad-texture">
            <MarkStyle>
                <!--<ImageStyle Image="tree-plus" PressedImage="tree-minus"/>-->
                <ImageStyle Image="bad-texture" PressedImage="bad-texture"/>
            </MarkStyle>
            <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray"/>
        </TreeStyle>
    </TreeStyles>
    <HorizontalSplitPaneStyles>
        <HorizontalSplitPaneStyle>
            <!--<HandleStyle Background="splitpane" OverBackground="splitpane-over"/>-->
            <HandleStyle Background="bad-texture" OverBackground="bad-texture"/>
        </HorizontalSplitPaneStyle>
    </HorizontalSplitPaneStyles>
    <VerticalSplitPaneStyles>
        <VerticalSplitPaneStyle>
            <!--<HandleStyle Background="splitpane-vertical" OverBackground="splitpane-vertical-over"/>-->
            <HandleStyle Background="bad-texture" OverBackground="bad-texture"/>
        </VerticalSplitPaneStyle>
    </VerticalSplitPaneStyles>
    <HorizontalMenuStyles>
        <!--<HorizontalMenuStyle Background="button" SelectionHoverBackground="button-over" SelectionBackground="button-down" SpecialCharColor="red">-->
        <HorizontalMenuStyle Background="bad-texture" SelectionHoverBackground="bad-texture" SelectionBackground="bad-texture" SpecialCharColor="red">
            <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray" Padding="10, 0"/>
            <!--<SeparatorStyle Image="separator" Thickness="3"/>-->
            <SeparatorStyle Image="bad-texture" Thickness="3"/>
        </HorizontalMenuStyle>
    </HorizontalMenuStyles>
    <VerticalMenuStyles>
        <!--<VerticalMenuStyle Background="button" Border="#1BA1E2" BorderThickness="1" SelectionHoverBackground="button-over" SelectionBackground="button-down" SpecialCharColor="red">-->
        <VerticalMenuStyle Background="bad-texture" Border="#1BA1E2" BorderThickness="1" SelectionHoverBackground="bad-texture" SelectionBackground="bad-texture" SpecialCharColor="red">
            <ImageStyle Padding="10, 0, 0, 0"/>
            <LabelStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray" Padding="10, 0"/>
            <ShortcutStyle Font="default-font" TextColor="#b3b3b3" DisabledTextColor="gray" Padding="0, 0, 10, 0"/>
            <!--<SeparatorStyle Padding="0, 2" Image="separator-menu" Thickness="4"/>-->
            <SeparatorStyle Padding="0, 2" Image="bad-texture" Thickness="4"/>
            <!--<SeparatorStyle Padding="0, 2" Image="separator-menu" Thickness="4"/>-->
            <SeparatorStyle Padding="0, 2" Image="bad-texture" Thickness="4"/>
        </VerticalMenuStyle>
    </VerticalMenuStyles>
    <WindowStyles>
        <WindowStyle Background="panel-frame-medium" Padding="15">
            <TitleStyle Font="medium-font" TextColor="#b3b3b3"/>
            <CloseButtonStyle Padding="6" Background="button-small-default" OverBackground="button-small-over" PressedBackground="button-small-pressed">
                <ImageStyle Image="icon-close"/>
            </CloseButtonStyle>
        </WindowStyle>
    </WindowStyles>
</Stylesheet>