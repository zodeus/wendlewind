                            <ListItem>
                                <Item>VenomVial</Item>
                                <Amount>1</Amount>
                                <ChanceToDrop>.75</ChanceToDrop>
                            </ListItem>
                        </InventoryItems>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest1</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>FlamingMosquito</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Mosquito (specimen #1)</PawnName>
                        <BodySizeFactor>1</BodySizeFactor>
