<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ZoneDef>
        <Moniker>SmolderingSwamp</Moniker>
        <Label>Smoldering Swamp</Label>
        <Stage>10</Stage>
        <BackgroundTexturePath>Biome/SmolderingSwamp</BackgroundTexturePath>
        <BackgroundTextureTransparency>50</BackgroundTextureTransparency>
        <Resources>
            <ListItem>
                <Item>ShimmeringBark</Item>
                <Amount>1</Amount>
                <ChanceToHarvest>.7</ChanceToHarvest>
            </ListItem>
