                </Enemies>
            </ListItem>
            <ListItem>
                <PotentialLootBoxes>
                    <ListItem>TrinketChest3</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>FlamingMosquito</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Mosquito (specimen #3)</PawnName>
                        <BodySizeFactor>2</BodySizeFactor>
                        <InventoryItems>
                            <ListItem>
                                <Item>VenomVial</Item>
                                <Amount>1</Amount>
                                <ChanceToDrop>.75</ChanceToDrop>
                            </ListItem>
                        </InventoryItems>
                    </ListItem>
                </Enemies>
