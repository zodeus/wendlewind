            </ListItem>
            <ListItem>
                <PotentialLootBoxes>
                    <ListItem>TrinketChest3</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>FlamingMosquito</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Mosquito (specimen #2)</PawnName>
