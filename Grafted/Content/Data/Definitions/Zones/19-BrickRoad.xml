<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ZoneDef>
        <Moniker>BrickRoad</Moniker>
        <Label>Brick Road</Label>
        <Stage>19</Stage>
        <ZoneColor>200, 170, 80</ZoneColor>
        <Weathers>
            <ListItem>FallingLeaves</ListItem>
            <ListItem>Storm</ListItem>
            <ListItem>Showers</ListItem>
        </Weathers>
        <Resources>
            <ListItem>
                <Item>ElderBerry</Item>
                <Amount>1~2</Amount>
                <ChanceToHarvest>.6</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>HealingRoot</Item>
                <Amount>1~2</Amount>
                <ChanceToHarvest>.7</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>GoldCapMushroom</Item>
                <Amount>1</Amount>
                <ChanceToHarvest>.4</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>ShadeWood</Item>
                <Amount>1~2</Amount>
                <ChanceToHarvest>.5</ChanceToHarvest>
            </ListItem>
        </Resources>
        <Encounters>
            <ListItem>
                <MysteryProperties>
                    <PartsToRestore>2~3</PartsToRestore>
                    <OptionalRewards>
                        <ListItem>EverburningStone</ListItem>
                        <ListItem>BoneEater</ListItem>
                        <ListItem>ElvishLeaf</ListItem>
                        <ListItem>SoothingVibrations</ListItem>
                    </OptionalRewards>
                    <OptionalRewardsCount>1</OptionalRewardsCount>
                    <RestorablePartTypes>
                        <ListItem>Thumb</ListItem>
                        <ListItem>Finger</ListItem>
                        <ListItem>Hand</ListItem>
                    </RestorablePartTypes>
                </MysteryProperties>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>ArmorChest2</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Hydra</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Tin Man (model #1)</PawnName>
                        <BodySizeFactor>1</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>SupplyChest2</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>TinMan</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Tin Man (model #2)</PawnName>
                        <BodySizeFactor>1.3</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>MedicinalChest</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>TinMan</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Tin Man (model #3)</PawnName>
                        <BodySizeFactor>1.5</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ArmorChest2</ListItem>
                    <ListItem>TrinketChest2</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>TinMan</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Tin Man (model #4)</PawnName>
                        <BodySizeFactor>1.8</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <IsBoss>true</IsBoss>
                <MaxBoxes>3</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>TrinketChest3</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>TinMan</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Tin Man (model #5)</PawnName>
                        <BodySizeFactor>3</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
        </Encounters>
    </ZoneDef>
</Definitions>