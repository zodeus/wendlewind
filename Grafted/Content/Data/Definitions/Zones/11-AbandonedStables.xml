                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>ArmorChestChain</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Horse</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Horse (specimen #2)</PawnName>
                        <BodySizeFactor>1.3</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>MedicinalChest</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Horse</PawnDef>
