<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ZoneDef>
        <Moniker>SnakePit</Moniker>
        <Label>Snake Pit</Label>
        <Stage>17</Stage>
        <ZoneColor>60, 90, 50</ZoneColor>
        <Weathers>
            <ListItem>Storm</ListItem>
            <ListItem>Showers</ListItem>
            <ListItem>Neutral</ListItem>
        </Weathers>
        <Resources>
            <ListItem>
                <Item>Ichor</Item>
                <Amount>1</Amount>
                <ChanceToHarvest>.8</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>InkyCapMushroom</Item>
                <Amount>1</Amount>
                <ChanceToHarvest>.5</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>MullinStick</Item>
                <Amount>1~2</Amount>
                <ChanceToHarvest>.4</ChanceToHarvest>
            </ListItem>
            <ListItem>
                <Item>RawFish</Item>
                <Amount>1~2</Amount>
                <ChanceToHarvest>.7</ChanceToHarvest>
            </ListItem>
        </Resources>
        <Encounters>
            <ListItem>
                <MysteryProperties>
                    <PartsToRestore>2~4</PartsToRestore>
                    <OptionalRewards>
                        <ListItem>AcidFlask</ListItem>
                        <ListItem>ElvishLeaf</ListItem>
                        <ListItem>SoothingVibrations</ListItem>
                    </OptionalRewards>
                    <OptionalRewardsCount>1</OptionalRewardsCount>
                    <RestorablePartTypes>
                        <ListItem>Thumb</ListItem>
                        <ListItem>Finger</ListItem>
                        <ListItem>Hand</ListItem>
                        <ListItem>Foot</ListItem>
                    </RestorablePartTypes>
                </MysteryProperties>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>ArmorChest3</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Orc</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Hydra #1</PawnName>
                        <BodySizeFactor>0.8</BodySizeFactor>
                        <InventoryItems>
                            <ListItem>
                                <Item>RawMeat</Item>
                                <Amount>2~3</Amount>
                                <ChanceToDrop>1</ChanceToDrop>
                            </ListItem>
                        </InventoryItems>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ResourceChest2</ListItem>
                    <ListItem>SupplyChest2</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Hydra</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Hydra #2</PawnName>
                        <BodySizeFactor>1.0</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>ArmorChest3</ListItem>
                    <ListItem>MedicinalChest</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Hydra</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Hydra #3</PawnName>
                        <BodySizeFactor>1.3</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <MaxBoxes>2</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>TrinketChest2</ListItem>
                    <ListItem>WeaponChest2</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Hydra</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Hydra #4</PawnName>
                        <BodySizeFactor>1.6</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
            <ListItem>
                <IsBoss>true</IsBoss>
                <MaxBoxes>3</MaxBoxes>
                <PotentialLootBoxes>
                    <ListItem>TrinketChest3</ListItem>
                    <ListItem>EnchantedChestDefensive</ListItem>
                    <ListItem>EnchantedChestOffensive</ListItem>
                </PotentialLootBoxes>
                <Enemies>
                    <ListItem>
                        <PawnDef>Hydra</PawnDef>
                        <Loadout>EmptyLoadout</Loadout>
                        <PawnName>Hydra #5 (boss)</PawnName>
                        <BodySizeFactor>2</BodySizeFactor>
                    </ListItem>
                </Enemies>
            </ListItem>
        </Encounters>
    </ZoneDef>
</Definitions>
