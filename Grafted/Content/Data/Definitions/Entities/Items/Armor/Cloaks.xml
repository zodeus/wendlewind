<?xml version="1.0" encoding="utf-8"?>
<Definitions>
    <ItemDef Name="CloakBase" ParentName="ArmorBase" Abstract="true">
        <Moniker>CloakBase</Moniker>
        <EquipmentProperties>
            <SlotUsedToEquip>Cloak</SlotUsedToEquip>
        </EquipmentProperties>
    </ItemDef>
    <ItemDef ParentName="CloakBase">
        <Moniker>EvasionCloak</Moniker>
        <Label>Cloak of Evasion</Label>
        <Description>A cape that increases your evasion.</Description>
        <TexturePath>Entities/Item/Equipment/Armor/Cloak/Evasion</TexturePath>
        <BaseStats>
            <Evasion>0.1</Evasion>
        </BaseStats>
    </ItemDef>
    <ItemDef ParentName="CloakBase">
        <Moniker>StrengthCloak</Moniker>
        <Label>Cloak of Strength</Label>
        <Description>A cloak that increases your strength.</Description>
        <UiClass>CloakPanel</UiClass>
        <EquipmentProperties>
            <HandlerClass>StrengthCloakHandler</HandlerClass>
        </EquipmentProperties>
        <UpgradeProperties>
            <Upgrades>
                <Upgrade Level="1" Bonus="+1 Strength">
                    <ElvishLeaf>1</ElvishLeaf>
                </Upgrade>
                <Upgrade Level="2" Bonus="+2 Strength">
                    <ElvishLeaf>1</ElvishLeaf>
                    <RhinoSkin>1</RhinoSkin>
                    <GoldenBean>2</GoldenBean>
                </Upgrade>
            </Upgrades>
        </UpgradeProperties>
        <TexturePath>Entities/Item/Equipment/Armor/Cloak/Strength</TexturePath>
    </ItemDef>  
    <ItemDef ParentName="CloakBase">
        <Moniker>RejuvenationCloak</Moniker>
        <Label>Cloak of Rejuvenation</Label>
        <UiClass>CloakPanel</UiClass>
        <EquipmentProperties>
            <HandlerClass>RejuvenationCloakHandler</HandlerClass>
        </EquipmentProperties>
        <UpgradeProperties>
            <Upgrades>
                <Upgrade Level="1" Bonus="+100% Healing">
                    <ElvishLeaf>1</ElvishLeaf>
                </Upgrade>
                <Upgrade Level="2" Bonus="+200% Healing">
                    <ElvishLeaf>1</ElvishLeaf>
                    <RhinoSkin>1</RhinoSkin>
                    <GoldenBean>2</GoldenBean>
                </Upgrade>
            </Upgrades>
        </UpgradeProperties>
        <Description>A cloak that provides rejuvenation.</Description>
        <TexturePath>Entities/Item/Equipment/Armor/Cloak/Rejuvenation</TexturePath>
    </ItemDef>
    <ItemDef ParentName="CloakBase">
        <Moniker>RageCloak</Moniker>
        <Label>Cloak of Rage</Label>
        <Description>A cloak that engulfs your body in flames.</Description>
        <TexturePath>Entities/Item/Equipment/Armor/Cloak/Rage</TexturePath>
    </ItemDef>
    <ItemDef ParentName="CloakBase">
        <Moniker>ThornCloak</Moniker>
        <Label>Cloak of Thorns</Label>
        <Description>A cloak that covers you in thorns.</Description>
        <TexturePath>Entities/Item/Equipment/Armor/Cloak/Thorns</TexturePath>
    </ItemDef>
</Definitions>
