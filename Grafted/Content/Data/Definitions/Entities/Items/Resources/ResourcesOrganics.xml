<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="OrganicResource" ParentName="ItemResource" Abstract="true">
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>HealingRoot</Moniker>
        <Label>Healing Root</Label>
        <Description>Toot, toot, it's a healing root... Grind it, water it, sip it. A crimson root that glows with a warm light.</Description>
        <TexturePath>Entities/Item/Resource/Organic/HealingRoot</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>NettleLeaf</Moniker>
        <Label>Nettle Leaf</Label>
        <Description>A leaf from the nettle plant. It's sharp and stinging to the touch.</Description>
        <TexturePath>Entities/Item/Resource/Organic/NettleLeaf</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>ElderBerry</Moniker>
        <Label>Elder Berry</Label>
        <Description>I dreamed I was a butterfly, flitting around in the sky; then I awoke. Now I wonder: Am I a man who dreamt of being a butterfly, or am I a butterfly dreaming that I am a man?</Description>
        <TexturePath>Entities/Item/Resource/Organic/ElderBerry</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>PlantBulb</Moniker>
        <Label>Plant Bulb</Label>
        <Description>A bulb from a plant. Green and juicy, plump and ripe.</Description>
        <TexturePath>Entities/Item/Resource/Organic/PlantBulb</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>VenomVial</Moniker>
        <Label>Venom Vial</Label>
        <Description>Venomous liquid sealed in a vial.</Description>
        <TexturePath>Entities/Item/Resource/Organic/VenomVial</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>BoneShard</Moniker>
        <Label>Bone Shard</Label>
        <Description>A sharp shard of bone.</Description>
        <TexturePath>Entities/Item/Resource/Organic/BoneShard</TexturePath>
        <AmmoProperties>
            <DamageType>Sharp</DamageType>
            <DamageRange>25~100</DamageRange>
        </AmmoProperties>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>Fang</Moniker>
        <Label>Fang</Label>
        <Description>A sharp fang torn from a predator's maw. Makes for deadly ammunition.</Description>
        <TexturePath>Entities/Item/Resource/Organic/Fang</TexturePath>
        <AmmoProperties>
            <DamageType>Sharp</DamageType>
            <DamageRange>50~150</DamageRange>
        </AmmoProperties>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>Rock</Moniker>
        <Label>Rock</Label>
        <Description>A rock.</Description>
        <TexturePath>Entities/Item/Resource/Stone/Rock</TexturePath>
        <AmmoProperties>
            <DamageType>Blunt</DamageType>
            <DamageRange>50~150</DamageRange>
        </AmmoProperties>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>BeakPuss</Moniker>
        <Label>Beak Puss</Label>
        <Description>The puss of a beak-like creature. It stinks.</Description>
        <TexturePath>Entities/Item/Resource/Organic/BeakPuss</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>Ichor</Moniker>
        <Label>Ichor</Label>
        <Description>A viscous, black liquid. It's sticky and thick.</Description>
        <TexturePath>Entities/Item/Resource/Organic/Ichor</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">  
        <Moniker>HorseTooth</Moniker>
        <Label>Horse Tooth</Label>
        <Description>A sharp tooth from a horse. It's long and curved, perfect munition.</Description>
        <TexturePath>Entities/Item/Resource/Organic/HorseTooth</TexturePath>
        <AmmoProperties>
            <DamageType>Sharp</DamageType>
            <DamageRange>300~400</DamageRange>
        </AmmoProperties>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>SnakeOil</Moniker>
        <Label>Snake Oil</Label>
        <Description>A thick, oily liquid extracted from a snake's body.</Description>
        <TexturePath>Entities/Item/Resource/Organic/SnakeOil</TexturePath>
    </ItemDef>
    <ItemDef ParentName="OrganicResource">
        <Moniker>SerpentScale</Moniker>
        <Label>Serpent Scale</Label>
        <Description>A hard, scaly skin from a serpent. It's tough and durable.</Description>
        <TexturePath>Entities/Item/Resource/Organic/SerpentScale</TexturePath>
    </ItemDef>
</Definitions>