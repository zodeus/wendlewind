<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="CombatTrinket" ParentName="ItemTrinket" Abstract="true">
        <TrinketProperties>
            <Type>Combat</Type>
        </TrinketProperties>
    </ItemDef>
    <ItemDef ParentName="CombatTrinket">
        <Moniker>DeathRattle</Moniker>
        <Label>Death Rattle</Label>
        <TrinketProperties>
            <HandlerClass>DeathRattleHandler</HandlerClass>
        </TrinketProperties>
        <UiClass>DeathRattlePanel</UiClass>
        <WeaponProperties>
            <WeaponType>Trinket</WeaponType>
            <DamageType>Magic</DamageType>
        </WeaponProperties>
        <Description>When activated, hitting a body part charges this trinket.Once charged it will trigger a head rattle.</Description>
        <TexturePath>Entities/Item/Trinket/DeathRattle</TexturePath>
    </ItemDef>
    <ItemDef ParentName="CombatTrinket">
        <Moniker>BoneCracker</Moniker>
        <Label>Bone Cracker</Label>
        <UiClass>BoneCrackerPanel</UiClass>
        <TrinketProperties>
            <HandlerClass>BoneCrackerHandler</HandlerClass>
        </TrinketProperties>
        <Description>A bone crusher, cracks random bones.</Description>
        <TexturePath>Entities/Item/Trinket/BoneCracker</TexturePath>
    </ItemDef>
    <ItemDef ParentName="CombatTrinket">
        <Moniker>Slingshot</Moniker>
        <Label>Slingshot</Label>
        <UiClass>SlingshotPanel</UiClass>
        <Description>A sling shot for extra attacks.</Description>
        <TrinketProperties>
            <HandlerClass>SlingshotHandler</HandlerClass>
        </TrinketProperties>
        <UpgradeProperties>
            <Upgrades>
                <Upgrade Level="1" Bonus="+50% Dmg">
                    <RequiredTrinkets>TinkersToolbox</RequiredTrinkets>
                    <BoneShard>10</BoneShard>
                    <LeatherScraps>4</LeatherScraps>
                </Upgrade>
                <Upgrade Level="2" Bonus="-30% CD">
                    <RequiredTrinkets>TinkersToolbox</RequiredTrinkets>
                    <GoldenBean>5</GoldenBean>
                    <Fang>1</Fang>
                    <LeatherScraps>6</LeatherScraps>
                </Upgrade>
                <Upgrade Level="3" Bonus="Fully Automatic">
                    <RequiredTrinkets>TinkersToolbox, Monocle</RequiredTrinkets>
                    <GoldenBean>4</GoldenBean>
                    <Fuse>2</Fuse>
                </Upgrade>
            </Upgrades>
        </UpgradeProperties>
        <TexturePath>Entities/Item/Trinket/SlingshotWood</TexturePath>
    </ItemDef>
    
    <ItemDef ParentName="CombatTrinket">
        <Moniker>BloodyBell</Moniker>
        <Label>Bloody Bell</Label>
        <UiClass>BloodyBellPanel</UiClass>
        <TrinketProperties>
            <HandlerClass>BloodyBellHandler</HandlerClass>
        </TrinketProperties>
        <Description>A cursed bell that tolls for blood. When activated, your next attack drains the victim's blood and restores your own.</Description>
        <TexturePath>Entities/Item/Trinket/BloodyBell</TexturePath>
    </ItemDef>
    
