            <ValidEquipmentTypes>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>SoothingVibrationsHandler</HandlerClass>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/SoothingVibrations</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
