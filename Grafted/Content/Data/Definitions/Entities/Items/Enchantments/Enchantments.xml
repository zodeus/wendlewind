<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="ItemEnchantment" ParentName="ItemBase" Abstract="true">
        <StackLimit>1</StackLimit>
        <ItemType>Enchantment</ItemType>
        <UiClass>ResourcePanel</UiClass>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>SoothingVibrations</Moniker>
        <Label>Soothing Vibrations</Label>
        <Description>When struck it vibrates with life energy.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>SoothingVibrationsHandler</HandlerClass>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/SoothingVibrations</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>SpidersBite</Moniker>
        <Label>Spiders Bite</Label>
        <Description>Hit me once shame you, I bite you.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>SpidersBiteHandler</HandlerClass>
        </EnchantmentProperties>
        <WeaponProperties>
            <DamageType>Flesh</DamageType>
            <BodyPartModifiers>
                <ListItem>
                    <Def>BurningAcid</Def>
                    <DurationInTicks>80~240</DurationInTicks>
                    <Chance>.2</Chance>
                </ListItem>
            </BodyPartModifiers>
        </WeaponProperties>
        <TexturePath>Entities/Item/Enchantments/SpidersBite</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>BloodBath</Moniker>
        <Label>Blood Bath</Label>
        <Description>Time for the gore to pour.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>BloodBathHandler</HandlerClass>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/BloodBath</TexturePath>
    </ItemDef>
</Definitions>