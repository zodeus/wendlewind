<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>SpidersBite</Moniker>
        <Label>Spiders Bite</Label>
        <Description>Hit me once shame you, I bite you.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>SpidersBiteHandler</HandlerClass>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Acid</Def>
                    <DurationInTicks>60~120</DurationInTicks>
                    <Chance>.4</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/SpidersBite</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>FesteringWounds</Moniker>
        <Label>Festering Wounds</Label>
        <Description>It spreads...</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Festering</Def>
                    <DurationInTicks>60~240</DurationInTicks>
                    <Chance>.3</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/FesteringWounds</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>BoneEater</Moniker>
        <Label>Bone Eater</Label>
        <Description>Watch them crumble from the inside.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <BodyPartModifiers>
                <ListItem>
                    <Def>BoneDecay</Def>
                    <DurationInTicks>0</DurationInTicks>
                    <Chance>.25</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/BoneEater</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>EverburningStone</Moniker>
        <Label>Everburning Stone</Label>
        <Description>The stone never stops burning.</Description>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Burning</Def>
                    <DurationInTicks>40~120</DurationInTicks>
                    <Chance>.75</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/EverburningStone</TexturePath>
    </ItemDef>
</Definitions>