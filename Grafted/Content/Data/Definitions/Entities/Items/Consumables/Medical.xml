<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="MedicalItem" ParentName="ItemBase" Abstract="true">
        <UiClass>ConsumablePanel</UiClass>
        <ItemType>Medical</ItemType>
        <StackLimit>9999</StackLimit>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>Cauterize</Moniker>
        <Label>Cauterize</Label>
        <StackLimit>1</StackLimit>
        <Description>Cauterizes a severed limb (unsealed socket).</Description>
        <TexturePath>Entities/Item/Consumables/Cauterize</TexturePath>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MedKit</Moniker>
        <Label>Med Kit</Label>
        <Description>Good for patching the meat. Heals bone, flesh, skin and organs. Fully heals a single body part.</Description>
        <TexturePath>Entities/Item/Consumables/MedKit</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MedKitHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>ArterialThreads</Item>
                    <Count>2</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>ArterialThreads</Moniker>
        <Label>Arterial Threads</Label>
        <Description>Used to repair arteries.</Description>
        <TexturePath>Entities/Item/Consumables/ArterialThreads</TexturePath>
        <MedicinalProperties>
            <HandlerClass>ArterialThreadsHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>Thread</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MendersMist</Moniker>
        <Label>Menders Mist</Label>
        <Description>A little spritz of this goes a long way. Heals bone, flesh and skin. Travels through sockets.</Description>
        <TexturePath>Entities/Item/Consumables/MendersMist</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MendersMistHandler</HandlerClass>
        </MedicinalProperties>
        <BaseStats>
            <HealingValue>200</HealingValue>
        </BaseStats>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>WeepingBucket</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>EncasedFire</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>BalmyOintment</Moniker>
        <Label>Balmy Ointment</Label>
        <Description>Sooths the skin and meat, tingly and nice.</Description>
        <TexturePath>Entities/Item/Consumables/BalmyOintment</TexturePath>
        <MedicinalProperties>
            <HandlerClass>BalmyOintmentHandler</HandlerClass>
            <DurationInTicks>800</DurationInTicks>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>3</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>EncasedFire</ListItem>
                <ListItem>WeepingBucket</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>GoldCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>AntiNecroticSerum</Moniker>
        <Label>Anti Necrotic Serum</Label>
        <Description>Put it where it hurts.</Description>
        <TexturePath>Entities/Item/Consumables/AntiNecroticSerum</TexturePath>
        <MedicinalProperties>
            <HandlerClass>AntiNecroticSerumHandler</HandlerClass>
            <DurationInTicks>3000</DurationInTicks>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>EncasedFire</ListItem>
                <ListItem>WeepingBucket</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>DeathCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>VenomVial</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>Rejuvenator</Moniker>
        <Label>Rejuvenator</Label>
        <Description></Description>
        <TexturePath>Entities/Item/Consumables/Rejuvenator</TexturePath>
        <MedicinalProperties>
            
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>ThirdEye</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>MendersMist</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>MedKit</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>BalmyOintment</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
</Definitions>