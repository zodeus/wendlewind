<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="MedicalItem" ParentName="ItemBase" Abstract="true">
        <UiClass>MedicinalPanel</UiClass>
        <ItemType>Medical</ItemType>
        <StackLimit>9999</StackLimit>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>Cauterize</Moniker>
        <Label>Cauterize</Label>
        <StackLimit>1</StackLimit>
        <Description>Cauterizes a severed limb (unsealed socket).</Description>
        <TexturePath>Entities/Item/Medical/Cauterize</TexturePath>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MedKit</Moniker>
        <Label>Med Kit</Label>
        <Description>Good for patching the meat. Heals bone, flesh, skin and organs. Fully heals a single body part.</Description>
        <TexturePath>Entities/Item/Medical/MedKit</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MedKitHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>ArterialThreads</Item>
                    <Count>2</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>ArterialThreads</Moniker>
        <Label>Arterial Threads</Label>
        <Description>Used to repair arteries.</Description>
        <TexturePath>Entities/Item/Medical/ArterialThreads</TexturePath>
        <MedicinalProperties>
            <HandlerClass>ArterialThreadsHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>2</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>Thread</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MendersMist</Moniker>
        <Label>Menders Mist</Label>
        <Description>A little spritz of this goes a long way. Heals bone, flesh and skin. Travels through sockets.</Description>
        <TexturePath>Entities/Item/Medical/MendersMist</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MendersMistHandler</HandlerClass>
        </MedicinalProperties>
        <BaseStats>
            <HealingValue>200</HealingValue>
        </BaseStats>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>WeepingBucket</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>FlameStick</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>BalmyOintment</Moniker>
        <Label>Balmy Ointment</Label>
        <Description>Sooths the skin and meat, tingly and nice.</Description>
        <TexturePath>Entities/Item/Medical/BalmyOintment</TexturePath>
        <MedicinalProperties>
            <HandlerClass>BalmyOintmentHandler</HandlerClass>
            <DurationInTicks>800</DurationInTicks>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>3</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>FlameStick</ListItem>
                <ListItem>WeepingBucket</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>GoldCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>AntiNecroticSerum</Moniker>
        <Label>Anti Necrotic Serum</Label>
        <Description>Put it where it hurts.</Description>
        <TexturePath>Entities/Item/Medical/AntiNecroticSerum</TexturePath>
        <MedicinalProperties>
            <HandlerClass>AntiNecroticSerumHandler</HandlerClass>
            <DurationInTicks>1000</DurationInTicks>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>FlameStick</ListItem>
                <ListItem>WeepingBucket</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>InkyCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>VenomVial</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MendersMix</Moniker>
        <Label>Menders Mix</Label>
        <Description>A supreme blend of healing herbs and minerals.</Description>
        <TexturePath>Entities/Item/Medical/MendersMix</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MendersMixHandler</HandlerClass>
            <DurationInTicks>300</DurationInTicks>
        </MedicinalProperties>
        <BaseStats>
            <HealingValue>500</HealingValue>
        </BaseStats>
        <CraftingProperties>
            <AmountProduced>2</AmountProduced>
            <RequiredTrinkets>
                <ListItem>SteroidInjector</ListItem>
                <ListItem>MechanicalEye</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>MendersMist</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>BalmyOintment</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>Ichor</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>BoneCleanse</Moniker>
        <Label>Bone Cleanse</Label>
        <Description>A potent skeletal purifier. Cleanses all bones of impurities and restores structural integrity.</Description>
        <TexturePath>Entities/Item/Medical/BoneCleanse</TexturePath>
        <MedicinalProperties>
            <HandlerClass>BoneCleanseHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>FlameStick</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>BoneShard</Item>
                    <Count>2</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>StrengthenBones</Moniker>
        <Label>Strengthen Bones</Label>
        <Description>A fortifying bone elixir. Permanently increases skeletal density and fully restores bone integrity.</Description>
        <TexturePath>Entities/Item/Medical/StrengthenBones</TexturePath>
        <MedicinalProperties>
            <HandlerClass>StrengthenBonesHandler</HandlerClass>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>VialOfDuplicity</ListItem>
                <ListItem>CookingPot</ListItem>
                <ListItem>FlameStick</ListItem>
                <ListItem>SteroidInjector</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>MendersMist</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>MendersMix</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>BoneCleanse</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>BalmyOintment</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
</Definitions>