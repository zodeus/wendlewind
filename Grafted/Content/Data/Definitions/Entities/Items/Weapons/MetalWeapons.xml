                <ListItem>
                    <Substance>Chitin</Substance>
                    <Modifier>.03</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Flesh</Substance>
                    <Modifier>1.5</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Fungus</Substance>
                    <Modifier>.04</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
        <TexturePath>Entities/Item/Equipment/Weapon/Metal/IronDagger</TexturePath>
        <BaseStats>
            <MeleePower>25</MeleePower>
            <MaxDurability>2000</MaxDurability>
        </BaseStats>
        <DisassembleProperties>
            <Items>
                <ListItem>
                    <Item>IronNugget</Item>
                    <Count>2</Count>
                </ListItem>
            </Items>
