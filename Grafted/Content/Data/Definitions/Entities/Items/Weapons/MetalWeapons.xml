    <ItemDef ParentName="WeaponSharp">
        <Moniker>IronDagger</Moniker>
        <Label>Iron Dagger</Label>
        <Description>Very pointy</Description>
        <EquipmentProperties>
            <SlotUsedToEquip>HandWeapon</SlotUsedToEquip>
            <MaxEnchantments>1</MaxEnchantments>
        </EquipmentProperties>
        <WeaponProperties>
            <WeaponType>Dagger</WeaponType>
            <SubstanceModifiers>
                <ListItem>
