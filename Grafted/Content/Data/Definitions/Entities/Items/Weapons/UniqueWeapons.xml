<Definitions>
    <ItemDef ParentName="WeaponPiercing">
        <Moniker>BloodSuckler</Moniker>
        <Label>Blood Suckler</Label>
        <Description>A vampiric blade that hungers for kindred blood. The crimson edge whispers promises of vitality to those who share its thirst.</Description>
        <EquipmentProperties>
            <SlotUsedToEquip>HandWeapon</SlotUsedToEquip>
            <MaxEnchantments>2</MaxEnchantments>
        </EquipmentProperties>
        <WeaponProperties>
            <WeaponType>Dagger</WeaponType>
            <HandlerClass>BloodSucklerHandler</HandlerClass>
            <SubstanceModifiers ListKey="Substance">
                <ListItem>
                    <Substance>Flesh</Substance>
                    <Modifier>1.5</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Bone</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Metal</Substance>
                    <Modifier>0.3</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Stone</Substance>
                    <Modifier>0.3</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Chitin</Substance>
                    <Modifier>0.5</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
        <TexturePath>Entities/Item/Equipment/Weapon/Unique/BloodSuckler</TexturePath>
        <BaseStats>
            <WeaponPower>50</WeaponPower>
            <MaxDurability>5000</MaxDurability>
        </BaseStats>
    </ItemDef>
    
