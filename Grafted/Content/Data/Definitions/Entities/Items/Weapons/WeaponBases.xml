<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="WeaponBase" ParentName="ItemBase" Abstract="true">
        <ItemType>Equipment</ItemType>
        <StackLimit>1</StackLimit>
        <EquipmentProperties>
            <EquipmentType>Weapon</EquipmentType>
        </EquipmentProperties>
        <UiClass>WeaponPanel</UiClass>
    </ItemDef>
    <ItemDef Name="WeaponFlesh" ParentName="WeaponBase" Abstract="true">
        <WeaponProperties>
            <DamageType>Flesh</DamageType>
        </WeaponProperties>
    </ItemDef>
    <ItemDef Name="WeaponBlunt" ParentName="WeaponBase" Abstract="true">
        <WeaponProperties>
            <DamageType>Blunt</DamageType>
            <SubstanceModifiers ListKey="Substance">
                <ListItem>
                    <Substance>Flesh</Substance>
                    <Modifier>0.8</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Fungus</Substance>
                    <Modifier>0.8</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Wood</Substance>
                    <Modifier>0.6</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Metal</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Stone</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Bone</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Chitin</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
    </ItemDef>
    <ItemDef Name="WeaponSharp" ParentName="WeaponBase" Abstract="true">
        <WeaponProperties>
            <DamageType>Sharp</DamageType>
            <SubstanceModifiers ListKey="Substance">
                <ListItem>
                    <Substance>Flesh</Substance>
                    <Modifier>1.3</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Fungus</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Wood</Substance>
                    <Modifier>1</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Metal</Substance>
                    <Modifier>0.4</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Stone</Substance>
                    <Modifier>0.6</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Bone</Substance>
                    <Modifier>0.8</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Chitin</Substance>
                    <Modifier>0.6</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
    </ItemDef>
    <ItemDef Name="WeaponPiercing" ParentName="WeaponBase" Abstract="true">
        <WeaponProperties>
            <DamageType>Piercing</DamageType>
            <SubstanceModifiers ListKey="Substance">
                <ListItem>
                    <Substance>Flesh</Substance>
                    <Modifier>1.4</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Fungus</Substance>
                    <Modifier>1.3</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Wood</Substance>
                    <Modifier>0.7</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Metal</Substance>
                    <Modifier>0.2</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Stone</Substance>
                    <Modifier>0.4</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Bone</Substance>
                    <Modifier>1</Modifier>
                </ListItem>
                <ListItem>
                    <Substance>Chitin</Substance>
                    <Modifier>0.3</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
    </ItemDef>
    <ItemDef Name="WeaponMagic" ParentName="WeaponBase" Abstract="true">
    </ItemDef>
