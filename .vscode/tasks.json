{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Grafted.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Grafted.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Grafted.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch-hot-reload",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--hot-reload",
                "--project",
                "${workspaceFolder}/Grafted/Grafted.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Grafted"
            },
            "problemMatcher": "$msCompile",
            "isBackground": true
        }
    ]
}