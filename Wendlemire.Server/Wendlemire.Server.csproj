<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Wendlemire.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wendlemire.Simulation\Wendlemire.Simulation.csproj" />
    <ProjectReference Include="..\Wendlemire.NetCode\Wendlemire.NetCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Wendlemire\Content\Data\**\*">
      <Link>Content\Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

