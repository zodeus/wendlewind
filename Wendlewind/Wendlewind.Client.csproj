<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Wendlewind</AssemblyName>
        <RootNamespace>Wendlewind</RootNamespace>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Icon.ico" />
        <EmbeddedResource Include="Icon.bmp" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
        <None Remove="Icon.bmp.import" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Content\Data\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\Audio\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\Fonts\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\UI\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\Textures\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\Effects\Compiled\*.mgfxo">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="SpriteFontPlus">
            <HintPath>$(RepositoryRootDirectory)\deps\SpriteFontPlus\SpriteFontPlus.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
        <PackageReference Include="Myra" Version="1.5.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wendlewind.Simulation\Wendlewind.Simulation.csproj" />
        <ProjectReference Include="..\Wendlewind.NetCode\Wendlewind.NetCode.csproj" />
        <ProjectReference Include="..\Wendlewind.Renderer\Wendlewind.Renderer.csproj" />
        <ProjectReference Include="..\Wendlewind.PawnLayout\Wendlewind.PawnLayout.csproj" />
    </ItemGroup>
</Project>
