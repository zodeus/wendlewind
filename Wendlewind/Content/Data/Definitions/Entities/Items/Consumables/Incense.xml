<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef Name="IncenseConsumable" ParentName="ItemBase" Abstract="true">
        <ItemType>Incense</ItemType>
        <UiClass>IncensePanel</UiClass>
        <StackLimit>1</StackLimit>
    </ItemDef>
    <ItemDef ParentName="IncenseConsumable">
        <Moniker>MullinStick</Moniker>
        <Label>Mullin Stick</Label>
        <Description>A stick of Mullin wood, it's smell is calming and soothing.</Description>
        <GoldCost>20</GoldCost>
        <TexturePath>Entities/Item/Incense/MullinStick</TexturePath>
        <IncenseProperties>
            <DurationInEncounters>2</DurationInEncounters>
            <Effect>
                <Def>Mulled</Def>
                <DurationInTicks>4000</DurationInTicks>
            </Effect>
        </IncenseProperties>
        <CraftingProperties>
            <AmountProduced>2</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>WeepingBucket</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>Twig</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>NettleLeaf</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="IncenseConsumable">
        <Moniker>ShadeWood</Moniker>
        <Label>Shade Wood</Label>
        <Description>A stick of Shade wood, it's smell is mysterious and alluring.</Description>
        <GoldCost>20</GoldCost>
        <TexturePath>Entities/Item/Incense/ShadeWood</TexturePath>
        <IncenseProperties>
            <DurationInEncounters>2</DurationInEncounters>
            <Effect>
                <Def>Shaded</Def>
                <DurationInTicks>4000</DurationInTicks>
            </Effect>
        </IncenseProperties>
        <CraftingProperties>
            <AmountProduced>2</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>WeepingBucket</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>Twig</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>InkyCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="IncenseConsumable">
        <Moniker>DippedMullinStick</Moniker>
        <Label>Dipped Mullin</Label>
        <Description>A stick of Mullin wood, dipped in a golden substance, it's smell is calming and
            soothing and exhilirating.</Description>
        <GoldCost>55</GoldCost>
        <TexturePath>Entities/Item/Incense/DippedMullinStick</TexturePath>
        <IncenseProperties>
            <DurationInEncounters>3</DurationInEncounters>
            <Effect>
                <Def>WellMulled</Def>
                <DurationInTicks>2000</DurationInTicks>
            </Effect>
        </IncenseProperties>
        <CraftingProperties>
            <AmountProduced>2</AmountProduced>
            <RequiredTrinkets>
                <ListItem>TinkersToolbox</ListItem>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>WeepingBucket</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>GoldCapMushroom</Item>
                    <Count>1</Count>
                </ListItem>
                <ListItem>
                    <Item>MullinStick</Item>
                    <Count>2</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
    </ItemDef>
    <ItemDef ParentName="IncenseConsumable">
        <Moniker>WitchWood</Moniker>
        <Label>Witch Wood</Label>
        <Description>A stick of Witch wood, aromatic and invigorating.</Description>
        <GoldCost>70</GoldCost>
        <TexturePath>Entities/Item/Incense/WitchWood</TexturePath>
    </ItemDef>
</Definitions>