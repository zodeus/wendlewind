<?xml version="1.0" encoding="utf-8"?>
<Definitions>
    <ItemDef ParentName="ArmorBase">
        <Moniker>BlessedIronCollar</Moniker>
        <Label>Blessed Iron Collar</Label>
        <ItemType>Equipment</ItemType>
        <Description>A collar made of blessed iron. It is said to protect the wearer from harm. Leaf and Blood Bath on this collar attune the iron.</Description>
        <GoldCost>100</GoldCost>
        <EquipmentProperties>
            <SlotUsedToEquip>NeckArmor</SlotUsedToEquip>
            <MaxEnchantments>3</MaxEnchantments>
            <HandlerClass>BlessedIronCollarHandler</HandlerClass>
        </EquipmentProperties>
        <TexturePath>Entities/Item/Equipment/Armor/Unique/BlessedIronCollar</TexturePath>
        <BaseStats>
            <PhysicalResistance>28</PhysicalResistance>
            <MaxDurability>666</MaxDurability>
            <Weight>2</Weight>
        </BaseStats>
        <TrinketProperties>
            <Type>Equipment</Type>
        </TrinketProperties>
        <DisassembleProperties>
            <Items>
                <ListItem>
                    <Item>IronNugget</Item>
                    <Count>1</Count>
                </ListItem>
            </Items>
        </DisassembleProperties>
    </ItemDef>
    <ItemDef ParentName="LeatherArmorBase">
        <Moniker>PlagueMask</Moniker>
        <Label>Plague Mask</Label>
        <Description>It's a mask, a plague mask, a gas mask.</Description>
        <GoldCost>70</GoldCost>
        <TexturePath>Entities/Item/Equipment/Armor/Unique/PlagueMask</TexturePath>
        <EquipmentProperties>
            <SlotUsedToEquip>HeadArmor</SlotUsedToEquip>
            <MaxEnchantments>2</MaxEnchantments>
        </EquipmentProperties>
        <BaseStats>
            <PhysicalResistance>36</PhysicalResistance>
            <MaxDurability>500</MaxDurability>
        </BaseStats>
        <DisassembleProperties>
            <Items>
                <ListItem>
                    <Item>LeatherScraps</Item>
                    <Count>4</Count>
                </ListItem>
                <ListItem>
                    <Item>Thread</Item>
                    <Count>6</Count>
                </ListItem>
            </Items>
        </DisassembleProperties>
    </ItemDef>
</Definitions>
