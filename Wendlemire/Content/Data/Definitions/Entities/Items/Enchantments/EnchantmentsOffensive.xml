<?xml version="1.0" encoding="utf-8"?>

<Definitions>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>SpidersBite</Moniker>
        <Label>Spiders Bite</Label>
        <Description>Hit me once shame you, I bite you.\n\nBites more eagerly beside Rhino Skin on the same piece.</Description>
        <GoldCost>90</GoldCost>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
                <ListItem>Armor</ListItem>
            </ValidEquipmentTypes>
            <HandlerClass>SpidersBiteHandler</HandlerClass>
            <ScaleDuration>true</ScaleDuration>
            <ScalePower>true</ScalePower>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Acid</Def>
                    <DurationInTicks>32~64</DurationInTicks>
                    <Chance>.4</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/SpidersBite</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>FesteringWounds</Moniker>
        <Label>Festering Wounds</Label>
        <Description>It spreads...\n\nOpens faster in poisoned flesh.</Description>
        <GoldCost>85</GoldCost>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <ScaleChance>true</ScaleChance>
            <ScaleDuration>true</ScaleDuration>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Festering</Def>
                    <DurationInTicks>48~192</DurationInTicks>
                    <Chance>.24</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/FesteringWounds</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>BoneEater</Moniker>
        <Label>Bone Eater</Label>
        <Description>Watch them crumble from the inside.\n\nHungrier once flesh is already rotting, burning, or dissolving.</Description>
        <GoldCost>95</GoldCost>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <ScaleChance>true</ScaleChance>
            <ScalePower>true</ScalePower>
            <BodyPartModifiers>
                <ListItem>
                    <Def>BoneDecay</Def>
                    <DurationInTicks>0</DurationInTicks>
                    <Chance>.15</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/BoneEater</TexturePath>
    </ItemDef>
    <ItemDef ParentName="ItemEnchantment">
        <Moniker>EverburningStone</Moniker>
        <Label>Everburning Stone</Label>
        <Description>The stone never stops burning.</Description>
        <GoldCost>100</GoldCost>
        <EnchantmentProperties>
            <ValidEquipmentTypes>
                <ListItem>Weapon</ListItem>
            </ValidEquipmentTypes>
            <ScaleDuration>true</ScaleDuration>
            <ScalePower>true</ScalePower>
            <BodyPartModifiers>
                <ListItem>
                    <Def>Burning</Def>
                    <DurationInTicks>32~96</DurationInTicks>
                    <Chance>.45</Chance>
                </ListItem>
            </BodyPartModifiers>
        </EnchantmentProperties>
        <TexturePath>Entities/Item/Enchantments/EverburningStone</TexturePath>
    </ItemDef>
</Definitions>