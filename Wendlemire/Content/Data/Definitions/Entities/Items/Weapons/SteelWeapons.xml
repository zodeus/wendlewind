<Definitions>
    <ItemDef ParentName="WeaponSharp">
        <Moniker>Greatsword</Moniker>
        <Label>Greatsword</Label>
        <Description>A two-handed slab of steel. Wide cuts, empty off-hand.</Description>
        <GoldCost>200</GoldCost>
        <EquipmentProperties>
            <SlotUsedToEquip>HandWeapon</SlotUsedToEquip>
            <OccupiesBothHands>true</OccupiesBothHands>
            <MaxEnchantments>2</MaxEnchantments>
        </EquipmentProperties>
        <WeaponProperties>
            <WeaponType>Greatsword</WeaponType>
            <SubstanceModifiers>
                <ListItem>
                    <Substance>Wood</Substance>
                    <Modifier>1.2</Modifier>
                </ListItem>
            </SubstanceModifiers>
        </WeaponProperties>
        <TexturePath>Entities/Item/Equipment/Weapon/Steel/Greatsword</TexturePath>
        <BaseStats>
            <WeaponPower>98</WeaponPower>
            <MaxDurability>2400</MaxDurability>
        </BaseStats>
        <DisassembleProperties>
            <Items>
                <ListItem>
                    <Item>IronNugget</Item>
                    <Count>4</Count>
                </ListItem>
            </Items>
        </DisassembleProperties>
    </ItemDef>
