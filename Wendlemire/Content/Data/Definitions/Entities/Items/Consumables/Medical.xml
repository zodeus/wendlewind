    <ItemDef ParentName="MedicalItem">
        <Moniker>Cauterize</Moniker>
        <Label>Cauterize</Label>
        <StackLimit>1</StackLimit>
        <Description>Cauterizes a severed limb (unsealed socket).</Description>
        <GoldCost>150</GoldCost>
        <TexturePath>Entities/Item/Medical/Cauterize</TexturePath>
        <MedicinalProperties>
            <InfiniteUse>true</InfiniteUse>
            <CooldownInTicks>300</CooldownInTicks>
            <ApplyMode>WatchedPart</ApplyMode>
            <WatchPool>
                <ListItem>Socket</ListItem>
            </WatchPool>
            <AllowedTriggerTypes>
                <ListItem>PartSevered</ListItem>
            </AllowedTriggerTypes>
            <AllowedTargetSelectors>
                <ListItem>SeveredOrUnsealedSocket</ListItem>
            </AllowedTargetSelectors>
            <DefaultTrigger>
                <Type>PartSevered</Type>
                <TargetSelector>SeveredOrUnsealedSocket</TargetSelector>
            </DefaultTrigger>
        </MedicinalProperties>
    </ItemDef>
    <ItemDef ParentName="MedicalItem">
        <Moniker>MedKit</Moniker>
        <Label>Med Kit</Label>
        <Description>Good for patching the meat. Heals bone, flesh, skin and organs. Fully heals a single body part.</Description>
        <GoldCost>20</GoldCost>
        <TexturePath>Entities/Item/Medical/MedKit</TexturePath>
        <MedicinalProperties>
            <HandlerClass>MedKitHandler</HandlerClass>
            <CooldownInTicks>240</CooldownInTicks>
            <ApplyMode>NearestExternalAncestor</ApplyMode>
            <WatchPool>
                <ListItem>External</ListItem>
                <ListItem>Internal</ListItem>
            </WatchPool>
            <AllowedTriggerTypes>
                <ListItem>PartBelowHealth</ListItem>
                <ListItem>Immediately</ListItem>
                <ListItem>AfterSeconds</ListItem>
            </AllowedTriggerTypes>
            <AllowedTargetSelectors>
                <ListItem>Auto</ListItem>
                <ListItem>SpecificPart</ListItem>
            </AllowedTargetSelectors>
            <DefaultTrigger>
                <Type>PartBelowHealth</Type>
                <TargetSelector>Auto</TargetSelector>
                <HealthThreshold>0.5</HealthThreshold>
            </DefaultTrigger>
        </MedicinalProperties>
        <CraftingProperties>
            <AmountProduced>1</AmountProduced>
            <RequiredTrinkets>
                <ListItem>MortarAndPestle</ListItem>
                <ListItem>TinkersToolbox</ListItem>
            </RequiredTrinkets>
            <ResourceRequirements>
                <ListItem>
                    <Item>Suture</Item>
                    <Count>2</Count>
                </ListItem>
                <ListItem>
                    <Item>HealingRoot</Item>
                    <Count>1</Count>
                </ListItem>
            </ResourceRequirements>
        </CraftingProperties>
