    <ItemDef ParentName="CombatTrinket">
        <Moniker>Slingshot</Moniker>
        <Label>Slingshot</Label>
        <UiClass>SlingshotPanel</UiClass>
        <Description>A sling shot for extra attacks.</Description>
        <GoldCost>70</GoldCost>
        <TrinketProperties>
            <HandlerClass>SlingshotHandler</HandlerClass>
        </TrinketProperties>
        <UpgradeProperties>
            <Upgrades>
                <Upgrade Level="1" Bonus="+50% Dmg">
                    <RequiredTrinkets>TinkersToolbox</RequiredTrinkets>
                    <BoneShard>10</BoneShard>
                    <LeatherScraps>4</LeatherScraps>
                </Upgrade>
                <Upgrade Level="2" Bonus="+50% Dmg&#10;-30% CD">
                    <RequiredTrinkets>TinkersToolbox</RequiredTrinkets>
                    <GoldenBean>5</GoldenBean>
                    <Fang>1</Fang>
                    <LeatherScraps>6</LeatherScraps>
                </Upgrade>
                <Upgrade Level="3" Bonus="+50% Dmg&#10;-30% CD&#10;Fully Automatic">
                    <RequiredTrinkets>TinkersToolbox, Monocle</RequiredTrinkets>
                    <GoldenBean>4</GoldenBean>
                    <Fuse>2</Fuse>
                </Upgrade>
            </Upgrades>
        </UpgradeProperties>
        <TexturePath>Entities/Item/Trinket/SlingshotWood</TexturePath>
    </ItemDef>
    
    <ItemDef ParentName="CombatTrinket">
